{
  "name": "walkthrough-mcp",
  "version": "0.1.0",
  "description": "Run a change and answer what it actually does, with evidence. MCP server + CLI.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "walkthrough": "dist/cli/index.js",
    "walkthrough-mcp": "dist/mcp/index.js"
  },
  "main": "dist/core/index.js",
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:gate": "node scripts/test-gate.mjs",
    "e2e": "bash examples/run-e2e.sh",
    "demo": "npm run build && node examples/demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "playwright": "^1.48.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "mongodb": "^6.21.0",
    "mongodb-memory-server": "^10.4.3",
    "typescript": "^5.5.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
